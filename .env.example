# Copy this file to .env and adjust the values for your house.
# Keep .env private. Exact home coordinates should not be committed.

LOCATION_LABEL=Appleton, WI
HOME_LAT=44.2619
HOME_LON=-88.4154

# The map and API query cover this radius around HOME_LAT/HOME_LON.
SEARCH_RADIUS_MILES=45

# Aircraft inside this radius are highlighted as "overhead".
OVERHEAD_RADIUS_MILES=8

# OpenSky state polling interval. OpenSky applies rate limits, so keep this sane.
POLL_INTERVAL_SECONDS=120

# Optional but recommended. Create an OpenSky API client and paste it here.
# The app will still try anonymous requests when these are blank.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional runtime settings.
HOST=127.0.0.1
PORT=8787
FLIGHT_TRACKER_DB=data/flights.sqlite3

# Optional enrichment source for route, airline, aircraft type, registration, and photos.
ADSBDB_ENABLED=1
ADSBDB_CACHE_HOURS=12
ADSBDB_MAX_ENRICH_PER_REFRESH=12

# Hard ingestion filter. Aircraft below these values are discarded before storage.
COLLECT_MIN_SPEED_MPH=300
COLLECT_MIN_ALTITUDE_FT=10000

# Optional phone notifications through the ntfy app.
# 1. Install ntfy on your phone.
# 2. Subscribe to a long, private topic name.
# 3. Put that same topic below and set NOTIFY_ENABLED=1.
NOTIFY_ENABLED=0
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# "Look up" rule: fast, high aircraft near home and heading roughly toward you.
NOTIFY_MIN_SPEED_MPH=300
NOTIFY_MIN_ALTITUDE_FT=10000
NOTIFY_RADIUS_MILES=25
NOTIFY_APPROACH_DEGREES=45
NOTIFY_COOLDOWN_MINUTES=30

# Anomaly rules: emergency squawks and low/fast close passes.
NOTIFY_ANOMALIES=1
ANOMALY_LOW_ALTITUDE_FT=2500
ANOMALY_MIN_SPEED_MPH=180
ANOMALY_RADIUS_MILES=10
